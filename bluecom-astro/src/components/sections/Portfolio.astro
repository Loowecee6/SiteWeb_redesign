---
import { clients } from '@/data/clients';
---

<section id="clients" class="reveal">
  <div class="container">
    <div class="section-header">
      <div>
        <div class="section-label">
          <div class="section-label-line"></div>
          <span>Ils nous ont fait confiance</span>
        </div>
        <h2 class="section-title">Ils <em>nous</em> ont fait confiance</h2>
      </div>
      <p class="section-sub">Plus de 50 organisations leaders en Afrique de l'Ouest nous accordent leur confiance pour leur communication institutionnelle.</p>
    </div>
    <div class="clients-grid">
      {clients.map((client) => (
        <div class="client-logo-card">
          <div class="client-logo" style={`background: ${client.color};`}>
            <span class="client-initials">{client.initials}</span>
          </div>
          <span class="client-name">{client.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #clients { padding: var(--section-padding) 0; background: var(--white); }

  .clients-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin-top: 48px;
  }

  .client-logo-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 32px 16px;
    background: var(--cream);
    border-radius: 12px;
    transition: all var(--transition-normal);
  }

  .client-logo-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .client-logo {
    width: 100px;
    height: 100px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .client-initials {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--white);
    letter-spacing: 2px;
  }

  .client-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--anthracite);
    text-align: center;
    line-height: 1.3;
  }

  @media (max-width: 992px) {
    .clients-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 576px) {
    .clients-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
